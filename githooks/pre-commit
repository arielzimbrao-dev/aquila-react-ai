#!/bin/sh
# aquila-hooks v1 — shared git hook dispatcher of the aquila packages (aquila-ai, aquila-react-ai,
# aquila-next-ai). Byte-identical in all of them; `npx <package> init|sync` copies it to
# <repo root>/.aquila-hooks/ (core.hooksPath = .aquila-hooks). Do not edit: newer v1 copies replace it.
# For each line "<package> <dir>" of .aquila-hooks/projects (dir relative to the root, "." = the root)
# it runs `<package> gate <phase>` inside <dir>, only when the commit/push changes files there.
phase=$(basename "$0")
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
registry=.aquila-hooks/projects
if [ ! -f "$registry" ]; then
  echo "aquila: $registry missing — run \`npx <aquila package> init\` in each project" >&2
  exit 1
fi

all=
changed=
if [ "$phase" = pre-push ]; then
  # stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
  while read -r _lref lsha _rref rsha; do
    case "$lsha" in *[!0]*) ;; *) continue ;; esac # deleting a ref: nothing to check
    case "$rsha" in
      *[!0]*)
        if files=$(git diff --name-only "$rsha" "$lsha" 2>/dev/null); then
          changed="$changed
$files"
        else
          all=1 # remote commit not known locally: check everything
        fi
        ;;
      *) all=1 ;; # new branch: check everything
    esac
  done
else
  changed=$(git diff --cached --name-only)
fi

status=0
while read -r pkg dir; do
  case "$pkg" in '' | '#'*) continue ;; esac
  if [ -z "$all" ]; then
    if [ "$dir" = . ]; then
      [ -n "$(printf '%s' "$changed" | tr -d '\n')" ] || continue
    else
      printf '%s\n' "$changed" | awk -v d="$dir/" 'index($0, d) == 1 { f = 1 } END { exit !f }' || continue
    fi
  fi
  # The package's CLI: <dir>/node_modules first, then hoisted (workspaces) up to the root.
  bin=
  d=$dir
  while :; do
    if [ -f "$d/node_modules/$pkg/bin/aquila.mjs" ]; then
      bin="$top/$d/node_modules/$pkg/bin/aquila.mjs"
      break
    fi
    [ "$d" = . ] && break
    d=$(dirname "$d")
  done
  if [ -z "$bin" ]; then
    echo "aquila: $pkg not installed for $dir (no node_modules/$pkg) — run the install in $dir" >&2
    status=1
    continue
  fi
  echo "aquila: $phase → $dir ($pkg)"
  (cd "$dir" && node "$bin" gate "$phase" </dev/null) || status=1
done <"$registry"
exit $status
